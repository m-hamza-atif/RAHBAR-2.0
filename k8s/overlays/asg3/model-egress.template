apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: model-egress
  namespace: rahbar
spec:
  podSelector:
    matchExpressions:
    - key: app
      operator: In
      values: [api, indexer, eval]
  policyTypes: [Egress]
  egress:
  - to:
    - ipBlock:
        cidr: MODEL_CIDR
    ports:
    - protocol: TCP
      port: 11434
